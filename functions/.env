# Copy this file to ".env" (same folder) and fill in your own value(s).
# RESEND_API_KEY is NOT stored here - the deploy command asks for it and
# keeps it in Secret Manager instead.

# Use "onboarding@resend.dev" while testing - it works immediately with no
# setup. Switch to your own verified sending address once you have one.
RESEND_FROM=onboarding@resend.dev
node