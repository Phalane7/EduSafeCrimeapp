<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission for Firebase and maps -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Location permissions for SOS and crime map -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Permission to send emergency SMS alerts -->
    <uses-permission
        android:name="android.permission.SEND_SMS" />

    <!-- Permission for notifications -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Telephony is optional.
        This allows EduSafe to run on devices without
        telephone hardware, such as some tablets.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduSafe">

        <!-- Main Activity: Bottom Navigation -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- SOS Active Screen -->
        <activity
            android:name=".ui.sos.SosActiveActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Emergency SOS Activity -->
        <activity
            android:name=".ui.sos.EmergencySosActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Crime Map Activity -->
        <activity
            android:name=".ui.map.CrimeMapActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.EduSafe.Splash" />

        <!-- Get Started Screen -->
        <activity
            android:name=".GetStartedActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Login Screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Registration Screen -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Forgot Password Screen -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Email OTP Verification Screen -->
        <activity
            android:name=".VerifyEmailActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Create New Password Screen -->
        <activity
            android:name=".CreateNewPasswordActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action
                    android:name="android.intent.action.VIEW" />

                <category
                    android:name="android.intent.category.DEFAULT" />

                <category
                    android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="edusafe"
                    android:host="resetpassword" />

            </intent-filter>

        </activity>

    </application>

</manifest>

