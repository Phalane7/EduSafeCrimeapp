<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <LinearLayout
            android:id="@+id/commentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tvNoComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="No comments yet. Be the first."
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvReplyingTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:contentDescription="Cancel reply"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:textColor="@color/navy"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Write a comment…"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="300"
        android:minHeight="48dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted" />

    <TextView
        android:id="@+id/tvSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ui4_blue_button"
        android:clickable="true"
        android:contentDescription="Send comment"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="Send"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>