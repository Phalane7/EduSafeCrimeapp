<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="40dp" android:paddingBottom="32dp">
        <TextView style="@style/H1" android:text="@string/forgot_your_password"/>

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="Use the following recovery system to help you regain access to your account."
            tools:ignore="HardcodedText,TextContrastCheck" />
        <TextView style="@style/FieldLabel" android:layout_marginTop="26dp" android:text="@string/email_address"/>

        <EditText
            android:id="@+id/etEmail"
            style="@style/FieldInput"
            android:hint="name@vossie.net"
            android:inputType="textEmailAddress"
            tools:ignore="Autofill,HardcodedText,TextContrastCheck,VisualLintTextFieldSize" />
        <TextView android:id="@+id/tvEmailError" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/inter_regular" android:text="Invalid email. Please use your @vossie.net address." android:textColor="@color/signal_red" android:textSize="11sp" android:visibility="gone"
            tools:ignore="HardcodedText" />
        <Button android:id="@+id/btnNext" style="@style/PrimaryButton" android:layout_marginTop="26dp" android:text="Next"
            tools:ignore="HardcodedText,VisualLintButtonSize" />

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_regular"
            android:minHeight="48dp"
            android:text="&lt; Back to log in"
            android:textColor="@color/ink"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</ScrollView>