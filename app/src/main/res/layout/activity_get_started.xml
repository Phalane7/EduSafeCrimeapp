<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="40dp" android:paddingBottom="32dp">
    <!--  Picture area: fills the space above the text. Replace the src with your illustration/photo.  -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_edittext">
        <ImageView android:id="@+id/ivHero" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="EduSafe illustration" android:padding="24dp" android:scaleType="centerInside" android:src="@android:color/transparent"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_regular"
            android:text="PICTURE"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TextContrastCheck" />
    </FrameLayout>
    <TextView style="@style/H1" android:layout_marginTop="28dp" android:text="Campus safety."
        tools:ignore="HardcodedText" />
    <TextView style="@style/H2" android:layout_marginTop="4dp" android:text="One tap away."
        tools:ignore="HardcodedText" />

    <TextView
        style="@style/BodyText"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:text="Hold for help, always listening. Join EduSafe's campus safety network, report incidents and get help fast."
        tools:ignore="HardcodedText,TextContrastCheck" />
    <Button android:id="@+id/btnGetStarted" style="@style/PrimaryButton" android:layout_marginTop="28dp" android:text="Get Started"
        tools:ignore="HardcodedText,VisualLintButtonSize" />
</LinearLayout>