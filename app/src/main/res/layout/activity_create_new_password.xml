<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="40dp" android:paddingBottom="32dp">
        <TextView style="@style/H1" android:text="CREATE NEW PASSWORD"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="Please enter a new password."
            tools:ignore="HardcodedText,TextContrastCheck" />
        <TextView style="@style/FieldLabel" android:layout_marginTop="26dp" android:text="Enter new password"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etNewPassword"
            style="@style/FieldInput"
            android:inputType="textPassword"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck,VisualLintTextFieldSize" />
        <TextView style="@style/FieldLabel" android:text="Confirm new password"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etConfirmPassword"
            style="@style/FieldInput"
            android:inputType="textPassword"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck,VisualLintTextFieldSize" />
        <TextView android:id="@+id/tvPasswordError" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/inter_regular" android:text="Passwords do not match." android:textColor="@color/signal_red" android:textSize="11sp" android:visibility="gone"
            tools:ignore="HardcodedText" />
        <Button android:id="@+id/btnUpdatePassword" style="@style/PrimaryButton" android:layout_marginTop="26dp" android:text="Update Password"
            tools:ignore="HardcodedText,VisualLintButtonSize" />

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_regular"
            android:text=" &lt; Back to log in"
            android:textColor="@color/ink"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>
</ScrollView>