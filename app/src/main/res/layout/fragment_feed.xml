<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#EAF0FF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="News Safety Feed"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Share what you see. Everyone on campus can read, like and comment."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/ui4_white_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etPost"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:background="@null"
                android:contentDescription="Write a post"
                android:gravity="top"
                android:hint="Seen something suspicious or unsafe? Share it with campus..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Photo you are adding to your post"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAddPhoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="Add a photo"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_camera"
                    android:drawableTint="@color/navy"
                    android:text="Add photo"
                    android:textColor="@color/navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ui4_blue_button"
                    android:clickable="true"
                    android:contentDescription="Post"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingHorizontal="28dp"
                    android:text="Post"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="No posts yet. Be the first to share something."
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>