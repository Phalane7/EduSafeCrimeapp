<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#EAF0FF" android:fitsSystemWindows="true">
    <FrameLayout android:id="@+id/container" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_marginBottom="85dp" />
    <LinearLayout android:id="@+id/studentBottomNavigation" android:layout_width="match_parent" android:layout_height="75dp"
        android:layout_gravity="bottom" android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp" android:layout_marginBottom="10dp"
        android:background="@drawable/edusafe_nav_pill" android:gravity="center_vertical"
        android:orientation="horizontal" android:elevation="10dp" android:paddingHorizontal="7dp">
        <TextView android:id="@+id/tabHome" android:layout_width="0dp"
            android:layout_height="58dp" android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_home" android:drawableTint="@color/navy"
            android:drawablePadding="3dp" android:text="Home" android:textColor="@color/navy"
            android:textSize="10sp" android:textStyle="bold" android:clickable="true"
            android:focusable="true" android:contentDescription="Home" />
        <TextView android:id="@+id/tabMaps" android:layout_width="0dp"
            android:layout_height="58dp" android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_map" android:drawableTint="@color/muted"
            android:drawablePadding="3dp" android:text="Maps" android:textColor="@color/muted"
            android:textSize="10sp" android:textStyle="bold" android:clickable="true"
            android:focusable="true" android:contentDescription="Maps" />
        <TextView android:id="@+id/tabSos" android:layout_width="62dp"
            android:layout_height="62dp" android:layout_marginHorizontal="1dp"
            android:layout_marginBottom="14dp" android:background="@drawable/edusafe_nav_sos"
            android:gravity="center" android:elevation="8dp" android:text="SOS"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:clickable="true" android:focusable="true" android:contentDescription="SOS" />
        <TextView android:id="@+id/tabReports" android:layout_width="0dp"
            android:layout_height="58dp" android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_reports" android:drawableTint="@color/muted"
            android:drawablePadding="3dp" android:text="Reports" android:textColor="@color/muted"
            android:textSize="10sp" android:textStyle="bold" android:clickable="true"
            android:focusable="true" android:contentDescription="Reports" />
        <TextView android:id="@+id/tabProfile" android:layout_width="0dp"
            android:layout_height="58dp" android:layout_weight="1" android:gravity="center"
            android:drawableTop="@drawable/ic_person" android:drawableTint="@color/muted"
            android:drawablePadding="3dp" android:text="Profile" android:textColor="@color/muted"
            android:textSize="10sp" android:textStyle="bold" android:clickable="true"
            android:focusable="true" android:contentDescription="Profile" />
    </LinearLayout>
</FrameLayout>
