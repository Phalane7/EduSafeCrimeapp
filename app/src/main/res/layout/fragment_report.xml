<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/report_page_bg" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Report Incident" android:textSize="22sp" android:textColor="#10285A" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Help keep campus safe. It only takes a minute." android:textSize="11sp" android:textColor="#6980A5" android:layout_marginTop="3dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/formGroup" android:layout_marginTop="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TYPE OF INCIDENT" android:textSize="11sp" android:textColor="#4F6DA4" android:textStyle="bold" android:letterSpacing="0.06" />
            <LinearLayout android:id="@+id/chipRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="5dp" />
            <EditText android:id="@+id/etDesc" android:layout_width="match_parent" android:layout_height="136dp" android:layout_marginTop="12dp" android:background="@drawable/report_white_card" android:hint="What happened, when and where?" android:textColorHint="#7A8CAC" android:textColor="#102C62" android:textSize="14sp" android:gravity="top" android:padding="14dp" android:inputType="textMultiLine|textCapSentences" android:importantForAutofill="no" android:contentDescription="Describe what happened, when and where" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="118dp" android:orientation="horizontal" android:layout_marginTop="10dp">
                <LinearLayout android:id="@+id/tilePhoto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/report_tile_card" android:clickable="true" android:focusable="true" android:contentDescription="Add photo or video" android:layout_marginEnd="4dp">
                    <ImageView android:id="@+id/ivPhoto" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_camera" android:tint="#2856C6" android:padding="10dp" android:background="@drawable/report_icon_circle" android:importantForAccessibility="no" android:scaleType="centerCrop" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add photo or video" android:textSize="12sp" android:textColor="#102C62" android:id="@+id/tvPhoto" android:textStyle="bold" android:gravity="center" android:layout_marginTop="8dp" android:paddingHorizontal="4dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/tileLocation" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/report_tile_card" android:clickable="true" android:focusable="true" android:contentDescription="Locating…" android:layout_marginStart="4dp">
                    <ImageView android:id="@+id/tvDot" android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_location" android:tint="#2856C6" android:padding="10dp" android:background="@drawable/report_icon_circle" android:importantForAccessibility="no" android:scaleType="centerCrop" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Locating…" android:textSize="12sp" android:textColor="#102C62" android:id="@+id/tvLocation" android:textStyle="bold" android:gravity="center" android:layout_marginTop="8dp" android:paddingHorizontal="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/report_info_bg" android:padding="12dp" android:layout_marginTop="10dp">
                <TextView android:layout_width="26dp" android:layout_height="wrap_content" android:text="ⓘ" android:textSize="18sp" android:textColor="#2856C6" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Time stamped on submit. Sent to campus security, and on the map once verified. Your identity is never shown." android:textSize="11sp" android:textColor="#284676" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Submit report  →" android:textSize="15sp" android:textColor="#FFFFFF" android:id="@+id/btnSubmit" android:gravity="center" android:textStyle="bold" android:background="@drawable/report_button_bg" android:minHeight="54dp" android:layout_marginTop="14dp" android:clickable="true" android:focusable="true" android:contentDescription="Submit report" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/successGroup" android:visibility="gone" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/report_white_card" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Report saved" android:textSize="19sp" android:textColor="#102C62" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="It is saved on your phone and will be sent to campus security as soon as you are online." android:textSize="14sp" android:textColor="#425D86" android:layout_marginTop="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your tracking code:" android:textSize="12sp" android:textColor="#6980A5" android:layout_marginTop="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="28sp" android:textColor="#2856C6" android:id="@+id/tvCode" android:textStyle="bold" android:textIsSelectable="true" android:layout_marginTop="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keep this code. It is how you check your report's status without revealing who you are." android:textSize="12sp" android:textColor="#6980A5" android:layout_marginTop="10dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Report another incident" android:textSize="15sp" android:textColor="#FFFFFF" android:id="@+id/btnAnother" android:background="@drawable/report_button_bg" android:gravity="center" android:minHeight="52dp" android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>