<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#EAF1FF" android:fillViewport="true"
    android:clipToPadding="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
      android:paddingTop="18dp" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="top|center_vertical">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="My Incident
Reports" android:textSize="25sp" android:lineSpacingExtra="-3dp"
            android:textStyle="bold" android:textColor="#0B235B" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="Your submitted reports, most recent first."
            android:textSize="11sp" android:textColor="#7183A6" />
      </LinearLayout>
      <TextView android:id="@+id/btnFilter" android:layout_width="wrap_content"
          android:layout_height="38dp" android:layout_marginStart="8dp"
          android:background="@drawable/hist_filter_bg" android:gravity="center"
          android:drawableStart="@drawable/ic_filter" android:drawablePadding="5dp"
          android:drawableTint="#2049AA" android:paddingStart="12dp" android:paddingEnd="12dp"
          android:text="Filter" android:textColor="#2049AA" android:textSize="12sp"
          android:clickable="true" android:focusable="true"
          android:contentDescription="Show or hide report filters" />
    </LinearLayout>
    <LinearLayout android:id="@+id/chipPanel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="13dp"
        android:orientation="vertical" android:visibility="visible" />
    <TextView android:id="@+id/btnNewReport" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="18dp"
        android:background="@drawable/hist_action_bg" android:gravity="center"
        android:drawableStart="@drawable/ic_add" android:drawableTint="#FFFFFF"
        android:drawablePadding="10dp" android:text="Report an Incident"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
        android:clickable="true" android:focusable="true" />
    <LinearLayout android:id="@+id/listContainer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="17dp"
        android:orientation="vertical" />
    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="55dp"
        android:layout_marginBottom="40dp" android:orientation="vertical"
        android:gravity="center" android:visibility="gone">
      <ImageView android:layout_width="176dp" android:layout_height="176dp"
          android:src="@drawable/hist_empty_illustration"
          android:contentDescription="No reports illustration" />
      <TextView android:id="@+id/emptyTitle" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginTop="12dp"
          android:text="No reports yet" android:textSize="18sp" android:textStyle="bold"
          android:gravity="center" android:textColor="#10295E" />
      <TextView android:id="@+id/emptySubtitle" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginTop="8dp"
          android:paddingStart="24dp" android:paddingEnd="24dp"
          android:text="You haven't submitted any reports yet. Once you do, they'll show up here with their status."
          android:textSize="12sp" android:gravity="center" android:textColor="#7285AB" />
    </LinearLayout>
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone" android:text="No reports yet" />
    <TextView android:id="@+id/tvFooter" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:text="You have reached the end." android:textSize="12sp"
        android:gravity="center" android:textColor="#7285AB" android:visibility="gone" />
  </LinearLayout>
</ScrollView>
