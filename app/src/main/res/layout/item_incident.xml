<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/hist_report_card_bg">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#10295E"
            android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvLocation" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="7dp"
            android:textColor="#667A9F" android:textSize="13sp" />
        <TextView android:id="@+id/tvTime" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="#8190AE" android:textSize="12sp" />
        <TextView android:id="@+id/tvExtra" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="9dp"
            android:textColor="#5873A3" android:textSize="12sp"
            android:visibility="gone" />
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/hist_status_pill_bg"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <ImageView android:id="@+id/ivThumb" android:layout_width="84dp"
        android:layout_height="84dp" android:layout_marginStart="12dp"
        android:background="@drawable/hist_thumb_bg"
        android:clipToOutline="true" android:scaleType="centerCrop"
        android:contentDescription="Report photo or video preview"
        android:visibility="gone" />
</LinearLayout>
