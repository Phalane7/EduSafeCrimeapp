<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="11dp" android:background="@drawable/edusafe_contacts_card"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="13dp" android:paddingEnd="10dp" android:paddingVertical="15dp">
    <TextView android:id="@+id/tvAvatar" android:layout_width="46dp"
        android:layout_height="46dp" android:background="@drawable/edusafe_contacts_avatar"
        android:gravity="center" android:importantForAccessibility="no"
        android:textColor="#2454C9" android:textSize="15sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView android:id="@+id/tvName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#0B2257"
            android:textSize="15sp" android:textStyle="bold" android:maxLines="2" />
        <TextView android:id="@+id/tvPhone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="#71809D" android:textSize="12sp" />
        <TextView android:id="@+id/tvPriority" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:background="@drawable/edusafe_contacts_priority"
            android:paddingHorizontal="9dp" android:paddingVertical="4dp"
            android:textColor="#2454C9" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/btnUp" android:layout_width="36dp"
        android:layout_height="44dp" android:padding="8dp" android:src="@drawable/ic_up"
        android:tint="#2454C9" android:clickable="true" android:focusable="true"
        android:contentDescription="Move up in priority" />
    <ImageView android:id="@+id/btnDown" android:layout_width="36dp"
        android:layout_height="44dp" android:padding="8dp" android:src="@drawable/ic_down"
        android:tint="#2454C9" android:clickable="true" android:focusable="true"
        android:contentDescription="Move down in priority" />
</LinearLayout>
